+# platina-fix.config
+# En son uygulanan fragment - onceki fragmentlerin ayarlarini ezer.
+#
+# CFI (Control Flow Integrity) KAPATILDI.
+# Sebep: vendor'in Venus video kodlayici kodunda fonksiyon isaretcisi tip
+# uyusmazligi var. CFI acikken bu ihlal PANIK uretiyor ve video kaydinda
+# telefon tamamen donup yeniden basliyor.
+#   ro.boot.bootreason = kernel_panic,cfi_failure_hard,
+#                        hfi_*_session_get_seq_hdr
+# CONFIG_CFI_PERMISSIVE kapali oldugu icin ihlal uyari degil olumcul.
+# Bakimcinin kendi yapilandirmasi sdm660-common.config'i kullanmiyor,
+# dolayisiyla onun build'lerinde CFI zaten kapali.
+# CONFIG_CFI_CLANG is not set
+# CONFIG_CFI_CLANG_SHADOW is not set
+# CONFIG_CFI is not set
